# ---------------------------------------------------------------------------
# API (packages/api/.env). Everything here is optional to boot: the server
# starts without any of it and degrades loudly rather than silently.
# ---------------------------------------------------------------------------

# Admin login. ADMIN_PASSWORD_HASH wins when both are set; ADMIN_PASSWORD is a
# plaintext fallback for local work. Generate a hash with `npm run hash-password`.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD="change-me"

# Required to issue admin tokens. Any long random string.
JWT_SECRET="change-me-to-something-long-and-random"

# Firestore. Without it the API serves the bundled fallback content read-only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary image uploads. Without it the admin portal hides the upload control.
CLOUDINARY_URL=

# Contact form. Resend is the production path (Render's free tier blocks SMTP
# ports). Omit both and POST /api/contact returns 503 instead of dropping mail.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
CONTACT_TO=you@example.com

# SMTP fallback, used only when RESEND_API_KEY is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Web (build-time, set as GitHub Actions secrets for the deploy)
# ---------------------------------------------------------------------------
VITE_API_URL=
VITE_DEFAULT_LANG=en

# Cloudflare Web Analytics beacon token. Not a secret — it ends up in the page source
# regardless — so set it as a repository *variable*, not a secret. Leave it unset and no
# analytics script is injected at all.
VITE_CF_BEACON_TOKEN=
